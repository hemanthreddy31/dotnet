<Window x:Class="_10WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_10WPF"
        mc:Ignorable="d"
        Title="Shopping Billing Counter" Height="900" Width="1400" 
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" Opacity="0.1" 
                                    ShadowDepth="2" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1976D2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🛒" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Shopping Billing Counter" 
                             FontSize="20" FontWeight="Bold" 
                             Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Cashier: Admin" Foreground="White" 
                             VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock x:Name="DateTimeText" Foreground="White" 
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Product Search & Quick Items -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Section -->
                    <StackPanel Grid.Row="0" Margin="20">
                        <TextBlock Text="Product Search" FontSize="18" 
                                 FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBox x:Name="BarcodeTextBox" 
                               Style="{StaticResource ModernTextBox}"
                               Text="Enter barcode or product name..."
                               Foreground="Gray" GotFocus="BarcodeTextBox_GotFocus"
                               LostFocus="BarcodeTextBox_LostFocus"
                               KeyDown="BarcodeTextBox_KeyDown"/>
                        
                        <Button Content="Add to Cart" 
                              Style="{StaticResource ModernButton}"
                              Margin="0,10,0,0" Click="AddToCart_Click"/>
                    </StackPanel>

                    <!-- Manual Entry -->
                    <StackPanel Grid.Row="1" Margin="20,0,20,20">
                        <TextBlock Text="Manual Entry" FontSize="16" 
                                 FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBox x:Name="ProductNameTextBox" 
                                   Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource ModernTextBox}"
                                   Text="Product Name" Margin="0,0,5,5"/>
                            
                            <TextBox x:Name="ProductPriceTextBox" 
                                   Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource ModernTextBox}"
                                   Text="Price" Margin="5,0,0,5"/>
                            
                            <TextBox x:Name="ProductQuantityTextBox" 
                                   Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource ModernTextBox}"
                                   Text="1" Margin="0,5,5,5"/>
                            
                            <Button Grid.Row="1" Grid.Column="1" 
                                  Content="Add" 
                                  Style="{StaticResource ModernButton}"
                                  Margin="5,5,0,5" Click="ManualAdd_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Quick Items -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,20">
                        <TextBlock Text="Quick Items" FontSize="16" 
                                 FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <WrapPanel>
                            <Button Content="Milk - $3.99" Tag="Milk|3.99" 
                                  Style="{StaticResource ModernButton}"
                                  Background="#4CAF50" Margin="5" Click="QuickItem_Click"/>
                            <Button Content="Bread - $2.50" Tag="Bread|2.50"
                                  Style="{StaticResource ModernButton}"
                                  Background="#4CAF50" Margin="5" Click="QuickItem_Click"/>
                            <Button Content="Eggs - $4.99" Tag="Eggs|4.99"
                                  Style="{StaticResource ModernButton}"
                                  Background="#4CAF50" Margin="5" Click="QuickItem_Click"/>
                            <Button Content="Banana - $1.99" Tag="Banana|1.99"
                                  Style="{StaticResource ModernButton}"
                                  Background="#4CAF50" Margin="5" Click="QuickItem_Click"/>
                            <Button Content="Water - $1.50" Tag="Water|1.50"
                                  Style="{StaticResource ModernButton}"
                                  Background="#4CAF50" Margin="5" Click="QuickItem_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Panel - Shopping Cart & Checkout -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <Grid Grid.Row="0" Margin="20,20,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Shopping Cart" 
                                 FontSize="18" FontWeight="Bold"/>
                        
                        <Button Grid.Column="1" Content="Clear Cart" 
                              Style="{StaticResource ModernButton}"
                              Background="#F44336" Click="ClearCart_Click"/>
                    </Grid>

                    <!-- Cart Items -->
                    <DataGrid x:Name="CartDataGrid" Grid.Row="1" 
                            Margin="20,0,20,10" AutoGenerateColumns="False"
                            CanUserAddRows="False" CanUserDeleteRows="False"
                            GridLinesVisibility="None" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" 
                                              Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" 
                                              Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" 
                                              Width="60"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" 
                                              Width="80" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Action" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="❌" Background="#F44336" 
                                              Foreground="White" BorderThickness="0"
                                              Padding="5" Click="RemoveItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Totals Section -->
                    <Border Grid.Row="2" Background="#F8F9FA" 
                          CornerRadius="5" Margin="20,0,20,10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" FontSize="14"/>
                            <TextBlock x:Name="SubtotalText" Grid.Row="0" Grid.Column="1" 
                                     Text="$0.00" FontSize="14" FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tax (8%):" FontSize="14"/>
                            <TextBlock x:Name="TaxText" Grid.Row="1" Grid.Column="1" 
                                     Text="$0.00" FontSize="14"/>

                            <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Total:" 
                                     FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalText" Grid.Row="3" Grid.Column="1" 
                                     Text="$0.00" FontSize="18" FontWeight="Bold" 
                                     Foreground="#1976D2"/>
                        </Grid>
                    </Border>

                    <!-- Payment Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" 
                              HorizontalAlignment="Center" Margin="20">
                        <Button Content="💳 Credit Card" 
                              Style="{StaticResource ModernButton}"
                              Background="#4CAF50" Margin="5" Width="120"
                              Click="PaymentMethod_Click" Tag="Credit"/>
                        <Button Content="💵 Cash" 
                              Style="{StaticResource ModernButton}"
                              Background="#FF9800" Margin="5" Width="120"
                              Click="PaymentMethod_Click" Tag="Cash"/>
                        <Button Content="📱 Digital Pay" 
                              Style="{StaticResource ModernButton}"
                              Background="#9C27B0" Margin="5" Width="120"
                              Click="PaymentMethod_Click" Tag="Digital"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#263238">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" Grid.Column="0" 
                         Text="Ready for next customer" 
                         Foreground="White" VerticalAlignment="Center" 
                         Margin="20,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Items: " Foreground="#B0BEC5"/>
                    <TextBlock x:Name="ItemCountText" Text="0" 
                             Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text=" | Total: " Foreground="#B0BEC5" Margin="10,0,0,0"/>
                    <TextBlock x:Name="StatusTotalText" Text="$0.00" 
                             Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
